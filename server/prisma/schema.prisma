generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SessionStatus {
  CREATED
  INTENT_PARSED
  INTENT_CONFIRMED
  CATALOG_READY
  PRODUCT_SELECTED
  REVIEW_PENDING
  APPROVED
  PERMIT_ISSUED
  ORDER_CREATED
  PAYMENT_VERIFIED
  BLOCKED
  CANCELLED
}
enum IntentStatus {
  PARSED
  CONFIRMED
  SUPERSEDED
}
enum EvaluationDecision {
  APPROVE
  REVIEW
  BLOCK
  APPROVE_WITH_OVERRIDE
}
enum PermitStatus {
  ISSUED
  RESERVED
  USED
  EXPIRED
  BLOCKED
  REVOKED
}
enum PaymentStatus {
  CREATING
  ORDER_CREATED
  ORDER_FAILED
  AUTHENTICATED
  CAPTURED
  FAILED
}

model User {
  id String @id @default(cuid())
  email String @unique
  displayName String
  passwordHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions ShoppingSession[]
}
model ShoppingSession {
  id String @id @default(cuid())
  userId String
  scenarioId String?
  status SessionStatus @default(CREATED)
  aiMode String @default("fixture")
  paymentMode String @default("mock")
  currentIntentVersion Int @default(0)
  failureCode String?
  stateJson Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastActivityAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id])
  intents UserIntent[]
  offers OfferSet[]
  decisions AgentDecision[]
  agentRuns AgentRun[]
  chatMessages ChatMessage[]
  evaluations ChoiceProofEvaluation[]
  permits ExecutionPermit[]
  payments Payment[]
  receipts Receipt[]
  audits AuditEvent[]
}
model UserIntent {
  id String @id @default(cuid())
  sessionId String
  version Int
  rawPrompt String
  rulesJson Json
  missingFieldsJson Json?
  status IntentStatus @default(PARSED)
  intentHash String
  confirmedAt DateTime?
  createdAt DateTime @default(now())
  session ShoppingSession @relation(fields:[sessionId],references:[id],onDelete:Cascade)
  @@unique([sessionId,version])
}
model Product {
  id String @id
  catalogId String
  catalogVersion String
  merchant String
  sku String
  dataJson Json
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([catalogVersion,sku])
}
model OfferSet {
  id String @id @default(cuid())
  sessionId String
  catalogVersion String
  offerSetHash String
  offersJson Json
  eligibleProductIdsJson Json?
  excludedProductsJson Json?
  createdAt DateTime @default(now())
  session ShoppingSession @relation(fields:[sessionId],references:[id],onDelete:Cascade)
}
model AgentDecision {
  id String @id
  sessionId String
  agentRunId String?
  intentId String?
  offerSetId String?
  mode String
  selectedProductId String
  decisionJson Json
  provider String @default("fixture")
  model String @default("fixture")
  promptVersion String @default("v1")
  createdAt DateTime @default(now())
  session ShoppingSession @relation(fields:[sessionId],references:[id],onDelete:Cascade)
  agentRun AgentRun? @relation(fields:[agentRunId],references:[id],onDelete:SetNull)
}
model AgentRun {
  id String @id
  sessionId String
  intentId String?
  offerSetId String?
  provider String
  model String
  promptVersion String
  status String
  failureCode String?
  startedAt DateTime
  completedAt DateTime?
  session ShoppingSession @relation(fields:[sessionId],references:[id],onDelete:Cascade)
  toolCalls AgentToolCall[]
  decisions AgentDecision[]
}
model AgentToolCall {
  id String @id
  agentRunId String
  sequence Int
  toolName String
  inputJson Json
  outputJson Json
  status String
  createdAt DateTime @default(now())
  agentRun AgentRun @relation(fields:[agentRunId],references:[id],onDelete:Cascade)
  @@unique([agentRunId,sequence])
}
model ChatMessage {
  id String @id
  sessionId String
  clientMessageId String?
  sequence Int
  role String
  kind String
  text String
  structuredDataJson Json?
  createdAt DateTime @default(now())
  session ShoppingSession @relation(fields:[sessionId],references:[id],onDelete:Cascade)
  @@unique([sessionId,sequence])
  @@unique([sessionId,clientMessageId])
}
model ChoiceProofEvaluation {
  id String @id
  sessionId String
  selectedProductId String
  intentId String?
  offerSetId String?
  normalDecisionId String?
  cleanDecisionId String?
  decision EvaluationDecision
  evaluationJson Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  session ShoppingSession @relation(fields:[sessionId],references:[id],onDelete:Cascade)
  permits ExecutionPermit[]
}
model ExecutionPermit {
  id String @id
  sessionId String
  evaluationId String
  intentVersion Int @default(1)
  offerSetHash String @default("")
  productId String @default("")
  merchant String @default("")
  sku String @default("")
  quantity Int @default(1)
  amountPaise Int @default(0)
  currency String @default("INR")
  cartJson Json
  cartHash String
  signature String
  nonce String
  expiresAt DateTime
  issuedAt DateTime @default(now())
  status PermitStatus @default(ISSUED)
  reservedAt DateTime?
  reservationPaymentId String?
  usedAt DateTime?
  createdAt DateTime @default(now())
  session ShoppingSession @relation(fields:[sessionId],references:[id],onDelete:Cascade)
  evaluation ChoiceProofEvaluation @relation(fields:[evaluationId],references:[id])
  payments Payment[]
}
model Payment {
  id String @id
  sessionId String
  permitId String
  idempotencyKey String @unique
  requestHash String @default("")
  provider String
  providerOrderId String? @unique
  providerPaymentId String? @unique
  providerSignature String?
  amountPaise Int
  currency String
  status String @default("CREATING")
  paymentSignatureVerified Boolean @default(false)
  webhookVerified Boolean @default(false)
  failureCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  session ShoppingSession @relation(fields:[sessionId],references:[id],onDelete:Cascade)
  permit ExecutionPermit @relation(fields:[permitId],references:[id])
}
model Receipt {
  id String @id
  sessionId String
  evaluationId String?
  permitId String?
  paymentId String?
  kind String
  status String @default("CREATED")
  receiptJson Json
  receiptHash String
  receiptSignature String
  createdAt DateTime @default(now())
  session ShoppingSession @relation(fields:[sessionId],references:[id],onDelete:Cascade)
}
model AuditEvent {
  id String @id @default(cuid())
  sessionId String
  actor String
  eventType String
  entityType String?
  entityId String?
  metadataJson Json?
  createdAt DateTime @default(now())
  session ShoppingSession @relation(fields:[sessionId],references:[id],onDelete:Cascade)
}
model WebhookEvent {
  id String @id @default(cuid())
  provider String
  providerEventId String @unique
  eventType String
  signature String
  payloadHash String
  processed Boolean @default(false)
  processedAt DateTime?
  createdAt DateTime @default(now())
}
